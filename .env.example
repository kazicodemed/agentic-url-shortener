# Copy to .env and change the values. .env is git-ignored; never commit real secrets.
POSTGRES_PASSWORD=urlshortener_password
REDIS_PASSWORD=redis_password
PGADMIN_PASSWORD=admin
URL_SHORTENER_BASE_URL=http://localhost:8080

# Orchestration agents: stub (free, default) or claude (real calls, costs money).
ORCHESTRATION_AGENTS_MODE=stub
# Only needed for claude mode. Put the real key in .env only.
ANTHROPIC_API_KEY=
